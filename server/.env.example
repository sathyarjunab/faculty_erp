# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (CORS).
# In development, any localhost/127.0.0.1 port is allowed automatically.
CLIENT_URL=http://localhost:5173,http://localhost:5174

# ─────────────────────────────────────────────────────────────
# MySQL / Sequelize
# ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=faculty_ams
DB_USER=root
DB_PASSWORD=
# Set to true to see SQL logs in the console
DB_LOGGING=false

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────────────────────────────────────
# Google OAuth (SPA sends an ID token; backend verifies it)
# Create credentials at https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────
# OTP (email login)
# ─────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────
# SMTP / Email (Nodemailer)
# For local dev you can use https://ethereal.email or https://mailtrap.io
# If SMTP_HOST is left blank, OTP emails are printed to the console instead.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Faculty AMS <no-reply@faculty-ams.local>"

# ─────────────────────────────────────────────────────────────
# Grading
# ─────────────────────────────────────────────────────────────
PASS_PERCENTAGE=40
